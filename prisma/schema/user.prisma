model User {
  id            String        @id @default(uuid())
  name          String        @db.VarChar(255)
  email         String        @unique
  password      String
  active_status active_status @default(ACTIVE)
  role          UserRole      @default(USER)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  profile       Profile?

  comments      Comment[]

  @@map("users")
}
